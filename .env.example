# Required for Avery's replies. Set this in the host dashboard or in .env.local.
# Never commit a real key, and never paste it into an email.
# Chat still shows the Book a call button without it.
OPENAI_API_KEY=

# Optional. Defaults to the live AudioLink calendar.
# Rebuild after changing this — Next.js inlines NEXT_PUBLIC_ values at build time.
NEXT_PUBLIC_BOOKING_URL=https://calendar.audiolink.co/audiolink-call-579300

# Optional portrait. Read on the server. Leave blank to use the built-in illustration.
# AVERY_PORTRAIT_URL=https://example.com/avery.jpg
